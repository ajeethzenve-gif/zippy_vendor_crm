# Add these to the backend environment. Do not commit real SMTP credentials.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
# Vendor notifications can use a separate authorized sender.
VENDOR_FROM_EMAIL=
# Required: the approved public HTTPS portal origin (no trailing path).
VENDOR_PORTAL_URL=
